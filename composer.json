{
    "name": "ongudidan/laravel-multi-2fa",
    "version": "1.0.2",
    "description": "Unified Multi-Method Two-Factor Authentication for Laravel: Email OTP, Authenticator App (TOTP via Fortify), and Passkeys (WebAuthn).",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ongudidan",
            "email": "ongudidan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/session": "^11.0|^12.0|^13.0",
        "illuminate/mail": "^11.0|^12.0|^13.0",
        "laravel/fortify": "^1.20|^1.30|^1.40|^1.41",
        "laravel/passkeys": "^0.1|^0.2"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Required when rendering through the Inertia.js (Vue/React) frontend stack (^1.0|^2.0)."
    },
    "autoload": {
        "psr-4": {
            "Ongudidan\\Multi2fa\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ongudidan\\Multi2fa\\Multi2faServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
